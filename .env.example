# Porta do servidor (admin + redirects no mesmo processo)
PORT=3100

# Banco de dados. Vazio = SQLite local em HF_DATA_DIR/hf.db (zero configuração).
# Com a connection string do Supabase, o HF usa o Postgres de lá:
#   Supabase → Connect → Transaction pooler (porta 6543)
#   Ex.: postgresql://postgres.abcdefgh:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Antes: rode supabase/schema.sql no SQL Editor e copie os dados com `npm run db:migrate`.
DATABASE_URL=

# Pasta onde ficam hf.db (SQLite) e o segredo gerado automaticamente.
# Em Docker monte um volume aqui.
HF_DATA_DIR=./data

# Segredo usado para assinar o cookie de sessão e criptografar tokens da Cloudflare.
# Se vazio, o HF gera um e guarda em HF_DATA_DIR/.secret (não perca esse arquivo).
# Ao mudar de máquina (ex.: VPS), copie o MESMO valor, senão os tokens salvos ficam ilegíveis.
HF_SECRET=

# Primeiro administrador (opcional). Com os dois preenchidos e nenhum usuário no banco,
# o HF cria o admin sozinho ao subir (útil em Docker). Sem isso, /admin/setup pede.
HF_ADMIN_EMAIL=
HF_ADMIN_PASSWORD=

# Host onde o painel e a API respondem, além de localhost (ex.: hfredirect.online).
# Tem prioridade sobre o campo "Host do painel" das Configurações.
# Em qualquer outro host o HF só serve páginas white/redirects (domínios cadastrados) ou 404.
HF_ADMIN_HOST=
